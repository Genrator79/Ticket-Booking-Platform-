{
  "name": "high-concurrency-ticket-booking-platform",
  "version": "1.0.0",
  "description": "High-Concurrency Ticket Booking Platform",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspace=server && npm run build --workspace=client"
  },
  "keywords": [
    "ticket-booking",
    "concurrency",
    "postgresql",
    "redis",
    "distributed-systems"
  ],
  "author": "",
  "license": "ISC"
}
